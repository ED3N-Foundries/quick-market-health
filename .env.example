# Secrets / local overrides. Copy to .env (git-ignored).
PORT=3101
# Base URL of the quick-market API container / process.
# In docker compose on a shared network use http://quick-market:3001
TARGET_URL=http://127.0.0.1:3001
# Optional explicit websocket URL. Defaults to TARGET_URL with http->ws + /ws.
WS_TARGET=
# Chain RPC override. Defaults per chainKey from /api/config.
RPC_URL=
# How often the background loop re-probes even with no viewers.
CHECK_INTERVAL_MS=10000
# How many samples to keep for uptime / sparkbars.
HISTORY_N=180
# Page auto-refresh interval.
REFRESH_MS=5000
# Per-request timeout for API + RPC probes.
REQUEST_TIMEOUT_MS=8000
